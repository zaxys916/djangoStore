FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# 安装系统依赖
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    gcc \
    default-libmysqlclient-dev \
    pkg-config \
    netcat-openbsd \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件
COPY requirements.txt .

# 如果 requirements.txt 不存在，创建基本依赖
RUN if [ ! -f requirements.txt ]; then \
    echo "Django==4.2.7" > requirements.txt && \
    echo "djangorestframework==3.14.0" >> requirements.txt && \
    echo "pymysql==1.1.0" >> requirements.txt && \
    echo "mysqlclient==2.2.0" >> requirements.txt && \
    echo "redis==5.0.1" >> requirements.txt && \
    echo "django-cors-headers==4.3.1" >> requirements.txt; \
    fi

# 安装 Python 依赖（首次构建时安装，后续启动会自动补装）
RUN pip install --no-cache-dir -r requirements.txt -i https://mirrors.aliyun.com/pypi/simple/ || \
    pip install --no-cache-dir -r requirements.txt

# 复制代码
COPY . .

# 给启动脚本加执行权限
RUN chmod +x /app/entrypoint.sh 2>/dev/null || true

# 创建目录
RUN mkdir -p /app/staticfiles /app/media /app/logs

EXPOSE 8000

# 每次启动自动补装缺失依赖 + 等待数据库 + 迁移 + 启动
CMD ["sh", "/app/entrypoint.sh"]
